# ============================================================
# TEROR MISTIK — contoh environment
# Salin berkas ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local.
# ============================================================

# ——— Aplikasi ———
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Supabase (opsional) ———
# Tanpa dua nilai ini, aplikasi berjalan dalam Mode Lokal (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ——— Provider AI ———
# Kunci dibaca di server saja. Tidak pernah dikirim ke browser.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider utama untuk teks: openrouter | gemini
AI_PRIMARY_PROVIDER=openrouter
# Fallback otomatis: openrouter | gemini | none
AI_FALLBACK_PROVIDER=gemini

# Model default
OPENROUTER_MODEL=openrouter/auto
GEMINI_MODEL=gemini-2.5-flash
GROQ_WHISPER_MODEL=whisper-large-v3

# ——— Enkripsi kunci yang disimpan lewat UI ———
# Kosongkan untuk membuat kunci lokal otomatis di .data/.cipher-key.
# Di produksi, isi dengan string acak 32+ karakter.
TEROR_SECRET_KEY=
